{
  "name": "@procast/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx watch src/workers/index.ts",
    "build": "prisma generate && tsup src/server.ts src/workers/index.ts src/scripts/seed.ts src/scripts/preflight.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preflight": "tsx src/scripts/preflight.ts",
    "preflight:prod": "node dist/scripts/preflight.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "3.0.3",
    "bullmq": "5.76.4",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "date-fns": "4.1.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.4.1",
    "helmet": "8.1.0",
    "ioredis": "5.10.1",
    "jsonwebtoken": "9.0.3",
    "node-cron": "4.2.1",
    "pg": "8.20.0",
    "pino": "10.1.0",
    "pino-http": "11.0.0",
    "uuid": "14.0.0",
    "ws": "8.20.0",
    "zod": "4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "25.6.0",
    "@types/node-cron": "3.0.11",
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1",
    "eslint": "10.2.1",
    "prisma": "7.8.0",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  }
}
