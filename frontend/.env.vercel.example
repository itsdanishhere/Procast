# Keep this as /v1 on Vercel. The app route at /v1/* proxies requests to PROCAST_API_BASE_URL.
NEXT_PUBLIC_API_URL=/v1
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# Public backend origin. Prefer the origin only; /v1 is appended by the proxy route.
PROCAST_API_BASE_URL=https://api.your-domain.com
