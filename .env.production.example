NODE_ENV=production

# Public website/API URLs. Replace with your real domains.
FRONTEND_ORIGIN=https://procast.example.com
API_BASE_URL=https://api.procast.example.com
NEXT_PUBLIC_API_URL=https://api.procast.example.com/v1

# Optional when frontend and API share a parent domain, for example ".procast.example.com".
COOKIE_DOMAIN=

# Container ports exposed on the host.
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Database and Redis used by docker-compose.prod.yml.
POSTGRES_USER=procast
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=procast
DATABASE_URL=postgresql://procast:replace-with-a-long-random-database-password@postgres:5432/procast?schema=public
REDIS_URL=redis://redis:6379

# Generate unique secrets with at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-unique-64-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-unique-64-character-refresh-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

BACKUP_DIRECTORY=/app/backend/backups
